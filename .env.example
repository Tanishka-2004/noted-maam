# ==============================================================================
# Noted Ma'am - Centralized Environment Configuration Template
# ==============================================================================

# System Environment Mode (development, staging, production)
ENVIRONMENT=development

# --- DATABASE CONFIG (PostgreSQL with pgvector) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass
POSTGRES_DB=noted_maam_dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:postgres_secure_pass@db:5432/noted_maam_dev

# --- CACHE & SESSION (Redis) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- LOCAL QUEUE / REDIS STREAMS ---
REDIS_STREAM_URL=redis://redis:6379/1

# --- S3 / OBJECT STORAGE (MinIO locally) ---
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_admin_secure_pass
MINIO_ENDPOINT=http://minio:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=noted-maam-audio-chunks

# --- SECURITY & AUTHENTICATION ---
# Generate using: openssl rand -hex 32
JWT_SECRET_KEY=9d8df283bc9dfc01bc89a7df2b89d8efd2389d83c27189defd893fcebdf89e1b
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- EXTERNAL AI PROVIDER KEY (Optional fallback / summarization) ---
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# --- LOCAL MODEL SELECTION CONFIG ---
WHISPER_MODEL_PATH=openai/whisper-large-v3
DIARIZATION_MODEL_PATH=pyannote/speaker-diarization-3.1
SPACY_MODEL=en_core_web_sm
